<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= platform.name %> - StablecoinWatch</title>
    <link rel="stylesheet" href="/common.css">
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: '' , data: data }); %>

            <main>
                <div class="container">
                    <a href="/platforms" class="back-link">&larr; All Blockchains</a>

                    <% if (platform.notFound) { %>
                        <div class="glass-card" style="text-align: center; padding: 3rem;">
                            <h2 style="color: var(--text-primary); margin-bottom: 0.5rem;">Blockchain Not Found</h2>
                            <p class="text-secondary">The platform "<%= platform.name %>" was not found or has no stablecoin data.</p>
                        </div>
                    <% } else {
                        var chainCount = (data.platform_data || []).length;
                        var coinsBySymbol = {};
                        (data.stablecoins || []).forEach(function (c) { coinsBySymbol[c.symbol] = c; });
                        var coinsOnChain = platform.stablecoins || [];
                        var cards = coinsOnChain.filter(function (c) { return c.platform_value > 0; }).slice(0, 8);
                        var dom = platform.dominant_stablecoin;
                        var compact2 = function (v) { return h.formatCompact(v, { decimals: 2 }); };
                    %>
                        <section class="hero" aria-label="<%= platform.name %>">
                            <div class="hero-main">
                                <img src="<%= h.getChainIcon(platform.name) %>" alt="" class="hero-icon" onerror="this.style.display='none'">
                                <div>
                                    <h1><%= platform.name %></h1>
                                    <div class="hero-tags">
                                        <% if (platformIndex >= 0) { %><span class="tag">Rank #<%= platformIndex + 1 %></span><% } %>
                                        <span class="text-secondary" style="font-size: 0.875rem;">of <%= chainCount %> chains by stablecoin value</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="card-grid tight section" aria-label="Key figures">
                            <div class="card-pair">
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= platform.mcap_sum_s %></div>
                                    <div class="stat-label">Total Stablecoin Value</div>
                                    <div class="stat-sub">All pegs, valued in USD</div>
                                </div>
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= h.formatShare(platform.supply_percentage) %></div>
                                    <div class="stat-label">Share of All Chains</div>
                                    <div class="supply-bar" style="margin-top: 0.75rem;">
                                        <div class="supply-bar-fill" style="width: <%= Math.min(platform.supply_percentage || 0, 100) %>%"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-pair">
                                <div class="glass-card stat-card">
                                    <div class="stat-value <%= h.changeClass(platform.change_7d) %>"><%= h.formatSigned(platform.change_7d) %></div>
                                    <div class="stat-label">Supply 7d</div>
                                    <div class="stat-sub">USD-pegged coins on <%= platform.name %></div>
                                </div>
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= platform.coin_count %></div>
                                    <div class="stat-label">Active Stablecoins</div>
                                    <% if (dom) { %><div class="stat-sub">Dominant: <%= dom.name %><%= typeof dom.percentage === 'number' ? ', ' + dom.percentage.toFixed(1) + '%' : '' %></div><% } %>
                                </div>
                            </div>
                        </section>

                        <% if (cards.length > 0) { %>
                            <section class="section" aria-labelledby="dist-title">
                                <h2 id="dist-title" class="section-title">Supply Distribution</h2>
                                <div class="breakdown-grid">
                                    <% cards.forEach(function(coin) { %>
                                        <div class="breakdown-card">
                                            <div class="breakdown-head">
                                                <a href="/coins/<%= coin.uri %>"><%= coin.symbol %></a>
                                                <span class="breakdown-pct"><%= h.formatShare(coin.platform_percentage) %></span>
                                            </div>
                                            <div class="text-secondary" style="font-size: 0.85rem; margin-top: 0.25rem;"><%= coin.name %></div>
                                            <div style="font-weight: 600; margin-top: 0.25rem;"><%= compact2(coin.platform_value) %></div>
                                            <div class="supply-bar">
                                                <div class="supply-bar-fill" style="width: <%= Math.min(coin.platform_percentage || 0, 100) %>%"></div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                <% if (coinsOnChain.length > cards.length) { %>
                                    <p class="breakdown-more">&hellip; and <%= coinsOnChain.length - cards.length %> more stablecoins</p>
                                <% } %>
                            </section>
                        <% } %>

                        <section aria-labelledby="list-title">
                            <div class="section-head">
                                <h2 id="list-title" class="section-title">All Stablecoins on <%= platform.name %></h2>
                                <% if (coinsOnChain.length > 25) { %>
                                    <div class="search-box">
                                        <label for="coin-filter" class="sr-only">Filter by name or symbol</label>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="#94a3b8" stroke-width="2"></circle><path d="M20 20l-3.5-3.5" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"></path></svg>
                                        <input id="coin-filter" type="search" placeholder="Filter by name or symbol" autocomplete="off" data-search-input>
                                    </div>
                                <% } %>
                            </div>
                            <div class="glass-card table-card" data-table data-page-size="25">
                                <div class="table-scroll">
                                    <table class="glass-table" style="min-width: 1040px;">
                                        <caption class="sr-only">Stablecoins on <%= platform.name %> ranked by value</caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Rank</th>
                                                <th scope="col">Name</th>
                                                <th scope="col" class="text-right sorted" aria-sort="descending">Value on <%= platform.name %> &darr;</th>
                                                <th scope="col">% of Chain</th>
                                                <th scope="col" class="text-right">Supply 7d</th>
                                                <th scope="col" class="text-right">Price</th>
                                                <th scope="col">Peg</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% coinsOnChain.forEach(function(coin, index) {
                                                var full = coinsBySymbol[coin.symbol];
                                                var peg = h.getPegStatus(coin);
                                                var logo = coin.img_url || (full && full.img_url);
                                            %>
                                                <tr class="row-link" data-href="/coins/<%= coin.uri %>" data-search="<%= (coin.name + ' ' + coin.symbol).toLowerCase() %>">
                                                    <td class="text-secondary">#<%= index + 1 %></td>
                                                    <td>
                                                        <div class="coin-cell">
                                                            <% if (logo) { %>
                                                                <img src="<%= logo %>" alt="" class="logo" style="width: 28px; height: 28px;" loading="lazy">
                                                            <% } else { %>
                                                                <span class="logo logo-fallback" style="width: 28px; height: 28px;" aria-hidden="true"><%= (coin.name || '?').charAt(0).toUpperCase() %></span>
                                                            <% } %>
                                                            <div>
                                                                <a href="/coins/<%= coin.uri %>"><%= coin.name %></a>
                                                                <div class="coin-sub"><%= coin.symbol %></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="num"><%= compact2(coin.platform_value) %></td>
                                                    <td>
                                                        <div class="share-cell">
                                                            <div class="supply-bar"><div class="supply-bar-fill" style="width: <%= Math.min(coin.platform_percentage || 0, 100) %>%"></div></div>
                                                            <span><%= h.formatShare(coin.platform_percentage) %></span>
                                                        </div>
                                                    </td>
                                                    <td class="num <%= h.changeClass(coin.change_7d) %>"><%= h.formatSigned(coin.change_7d) %></td>
                                                    <td class="num"><%= h.formatPegPrice(coin.price) %></td>
                                                    <td>
                                                        <span class="badge <%= peg.badgeClass %>"><%= peg.text %></span>
                                                        <% if (peg.state !== 'neutral') { %><span class="sr-only"><%= peg.state === 'on' ? 'On peg' : (peg.state === 'drift' ? 'Drifting' : 'Off peg') %></span><% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="table-empty" data-empty <%= coinsOnChain.length > 0 ? 'hidden' : '' %>>
                                    <%= coinsOnChain.length > 0 ? 'No stablecoins match that name.' : 'No stablecoin data available for this blockchain.' %>
                                </p>
                                <div class="table-footer">
                                    <span>Value is on-chain supply &times; price.</span>
                                    <div class="pager">
                                        <span data-count><%= coinsOnChain.length %> stablecoins</span>
                                        <div class="pill-group" data-pager hidden>
                                            <button type="button" class="pill" data-prev aria-label="Previous page">&lsaquo;</button>
                                            <span class="sr-only" data-page aria-live="polite"></span>
                                            <button type="button" class="pill" data-next aria-label="Next page">&rsaquo;</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    <% } %>
                </div>
            </main>

            <%- include('partials/footer'); %>
    </div>
    <script src="/table-tools.js"></script>
</body>

</html>
