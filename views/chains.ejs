<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blockchains - StablecoinWatch</title>
    <link rel="stylesheet" href="/common.css">
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: 'chains' , data: data }); %>

            <main>
                <div class="container">
                    <h2 class="section-title">Top Blockchains</h2>

                    <div class="glass-card" style="padding: 0; overflow: hidden;">
                        <div style="overflow-x: auto;">
                            <table class="glass-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Chain</th>
                                        <th class="text-right">Market Cap</th>
                                        <th class="text-right">Coins</th>
                                        <th class="text-right">Dominance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (data && data.platform_data && data.platform_data.length> 0) { %>
                                        <% data.platform_data.forEach(function(chain, index) { %>
                                            <tr onclick="window.location='/chain/<%= chain.name %>'"
                                                style="cursor: pointer;">
                                                <td>
                                                    <span class="text-secondary">#<%= index + 1 %></span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-md">
                                                        <div style="font-weight: 600;">
                                                            <%= chain.name %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div style="font-weight: 500;">
                                                        <%= chain.mcap_sum_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <span class="badge badge-neutral">
                                                        <%= chain.coin_count %>
                                                    </span>
                                                </td>
                                                <td class="text-right">
                                                    <span class="text-primary">
                                                        <%= chain.supply_percentage_s %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="5" class="text-center" style="padding: 3rem;">
                                                            <div class="text-secondary">No blockchain data available
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>

            <%- include('partials/footer'); %>
    </div>
</body>

</html>