<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .site-header {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0.75rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
    }

    .brand img {
        height: 40px;
        width: auto;
        border-radius: 8px;
    }

    .brand-text {
        font-weight: 700;
        font-size: 1.25rem;
        color: var(--text-accent);
        display: none;
    }

    @media (min-width: 640px) {
        .brand-text { display: block; }
    }

    .header-right {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.25rem;
    }

    .nav-links {
        display: flex;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.03);
        padding: 0.25rem;
        border-radius: var(--radius-full);
        border: 1px solid var(--border-color);
    }

    .nav-link {
        padding: 0.5rem 1rem;
        border-radius: var(--radius-full);
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.875rem;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
    }

    .nav-link.active {
        background: var(--bg-card-hover);
        color: var(--text-accent);
        box-shadow: var(--shadow-sm);
    }

    .status-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: 44px;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .status-link:hover,
    .status-link.active {
        color: var(--text-primary);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-secondary);
    }

    .status-dot.healthy { background: #4ade80; }
    .status-dot.degraded { background: #facc15; }
    .status-dot.down { background: #f87171; }
</style>

<%
    var headerStatus = typeof systemStatus !== 'undefined' ? systemStatus : null;
    var headerDot = headerStatus === 'healthy' ? 'healthy'
        : (headerStatus === 'degraded' ? 'degraded'
        : (headerStatus === 'critical' || headerStatus === 'down' ? 'down' : ''));
    var headerUpdated = h.formatUtc(data && data.metrics && data.metrics.lastUpdated);
    var headerStatusText = headerDot === 'healthy' ? ' All systems operational.'
        : (headerDot ? ' Some data sources have issues.' : '');
%>
<header class="site-header">
    <div class="header-container">
        <a href="/" class="brand">
            <img src="/site_logo.PNG" alt="StablecoinWatch">
            <span class="brand-text" aria-hidden="true">StablecoinWatch</span>
        </a>

        <div class="header-right">
            <nav class="nav-links" aria-label="Primary">
                <a href="/" class="nav-link <%= active === 'home' ? 'active' : '' %>" <%- active === 'home' ? 'aria-current="page"' : '' %>>Stablecoins</a>
                <a href="/platforms" class="nav-link <%= active === 'chains' ? 'active' : '' %>" <%- active === 'chains' ? 'aria-current="page"' : '' %>>Blockchains</a>
            </nav>
            <a href="/status" class="status-link <%= active === 'status' ? 'active' : '' %>"
                aria-label="Data updated <%= headerUpdated %>.<%= headerStatusText %> View system status"
                <%- active === 'status' ? 'aria-current="page"' : '' %>>
                <span class="status-dot <%= headerDot %>" aria-hidden="true"></span>
                <span>Updated <%= headerUpdated %></span>
            </a>
        </div>
    </div>
</header>
