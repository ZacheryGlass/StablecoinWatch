<style>
    .site-footer {
        margin-top: auto;
        padding: var(--space-xl) 0;
        border-top: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.4);
    }

    .footer-content {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 var(--space-md);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-lg);
    }

    .footer-links {
        display: flex;
        gap: var(--space-lg);
    }

    .footer-link {
        color: var(--text-secondary);
        font-size: 0.875rem;
        transition: color 0.2s;
    }

    .footer-link:hover {
        color: var(--text-accent);
    }

    .footer-copy {
        color: var(--text-secondary);
        font-size: 0.875rem;
    }
</style>

<footer class="site-footer">
    <div class="footer-content">
        <div class="footer-copy">
            &copy; <%= new Date().getFullYear() %> StablecoinWatch. All rights reserved.
        </div>
        <div class="footer-links">
            <a href="https://github.com/ZacheryGlass/StablecoinWatch" target="_blank" class="footer-link">GitHub</a>
            <a href="/api-docs" class="footer-link">API</a>
            <a href="/status" class="footer-link">Status</a>
        </div>
    </div>
</footer>