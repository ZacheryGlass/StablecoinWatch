<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StablecoinWatch - Real-time Stablecoin Analytics</title>
    <link rel="stylesheet" href="/common.css">
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: 'home' , data: data }); %>

            <main>
                <div class="container">
                    <div class="grid-dashboard">
                        <!-- Market Cap Card -->
                        <div class="glass-card">
                            <h3 class="text-secondary"
                                style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Total
                                Market Cap</h3>
                            <div class="flex items-center gap-sm mt-2">
                                <span style="font-size: 2rem; font-weight: 700; color: var(--text-primary);">
                                    <%= (data && data.metrics && data.metrics.totalMCap_s) || '-' %>
                                </span>
                            </div>
                        </div>

                        <!-- Volume Card -->
                        <div class="glass-card">
                            <h3 class="text-secondary"
                                style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">24h
                                Volume</h3>
                            <div class="flex items-center gap-sm mt-2">
                                <span style="font-size: 2rem; font-weight: 700; color: var(--text-primary);">
                                    <%= (data && data.metrics && data.metrics.totalVolume_s) || '-' %>
                                </span>
                            </div>
                        </div>

                        <!-- Dominance Card -->
                        <div class="glass-card">
                            <h3 class="text-secondary"
                                style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Top Coin
                                Dominance</h3>
                            <div class="flex items-center gap-sm mt-2">
                                <span style="font-size: 2rem; font-weight: 700; color: var(--text-primary);">
                                    <%= (data && data.metrics && data.metrics.dominance) || '-' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <h2 class="section-title">Top Stablecoins</h2>

                    <div class="glass-card" style="padding: 0; overflow: hidden;">
                        <div style="overflow-x: auto;">
                            <table class="glass-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Name</th>
                                        <th>Price</th>
                                        <th class="text-right">Market Cap</th>
                                        <th class="text-right">Volume (24h)</th>
                                        <th class="text-right">Circulating Supply</th>
                                        <th>Chain</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (data && data.stablecoins && data.stablecoins.length> 0) { %>
                                        <% data.stablecoins.forEach(function(coin, index) { %>
                                            <tr onclick="window.location='/coins/<%= coin.uri %>'"
                                                style="cursor: pointer;">
                                                <td>
                                                    <span class="text-secondary">#<%= index + 1 %></span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-md">
                                                        <% if (coin.img_url) { %>
                                                            <img src="<%= coin.img_url %>" alt="<%= coin.name %>"
                                                                style="width: 32px; height: 32px; border-radius: 50%;">
                                                            <% } %>
                                                                <div>
                                                                    <div style="font-weight: 600;">
                                                                        <%= coin.name %>
                                                                    </div>
                                                                    <div class="text-secondary"
                                                                        style="font-size: 0.75rem;">
                                                                        <%= coin.symbol %>
                                                                    </div>
                                                                </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="font-weight: 500;"><%= coin.price_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div style="font-weight: 500;">
                                                        <%= coin.mcap_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div style="font-weight: 500;">
                                                        <%= coin.vol_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div class="text-secondary">
                                                        <%= coin.supply_s %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (coin.platforms && coin.platforms.length > 0) { %>
                                                        <div class="flex gap-sm" style="flex-wrap: wrap;">
                                                            <% coin.platforms.slice(0, 3).forEach(function(p) { %>
                                                                <span class="badge badge-success">
                                                                    <%= p.name %>
                                                                </span>
                                                                <% }); %>
                                                                    <% if (coin.platforms.length > 3) { %>
                                                                        <span class="badge"
                                                                            style="background: rgba(255,255,255,0.1);">+<%= coin.platforms.length - 3 %></span>
                                                                        <% } %>
                                                        </div>
                                                        <% } else { %>
                                                            <span class="text-secondary">-</span>
                                                            <% } %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center" style="padding: 3rem;">
                                                            <div class="text-secondary">No stablecoin data available
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>

            <%- include('partials/footer'); %>
    </div>
</body>

</html>