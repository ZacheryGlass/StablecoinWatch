<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Status - StablecoinWatch</title>
    <link rel="stylesheet" href="/common.css">
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: 'status', data: data }); %>

        <main>
            <div class="container">
                <h2 class="section-title">System Status</h2>

                <div class="grid-dashboard">
                    <div class="glass-card">
                        <h3 class="text-secondary"
                            style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Overall
                            Health</h3>
                        <div class="flex items-center gap-md" style="margin-top: 0.5rem;">
                            <% if (health && !health.error && health.status === 'healthy') { %>
                                <span class="badge badge-success"
                                    style="font-size: 1rem; padding: 0.5rem 1rem;">Operational</span>
                            <% } else { %>
                                <span class="badge badge-error"
                                    style="font-size: 1rem; padding: 0.5rem 1rem;">Issues Detected</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="glass-card">
                        <h3 class="text-secondary"
                            style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Last
                            Updated</h3>
                        <div class="flex items-center gap-md" style="margin-top: 0.5rem;">
                            <span style="font-size: 1.25rem; font-weight: 600; color: var(--text-primary);">
                                <%= (data && data.metrics && data.metrics.lastUpdated) ? new Date(data.metrics.lastUpdated).toLocaleString() : 'Unknown' %>
                            </span>
                        </div>
                    </div>

                    <% if (typeof mockMode !== 'undefined' && mockMode) { %>
                    <div class="glass-card">
                        <h3 class="text-secondary"
                            style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Data
                            Mode</h3>
                        <div class="flex items-center gap-md" style="margin-top: 0.5rem;">
                            <span class="badge badge-warning" style="font-size: 1rem; padding: 0.5rem 1rem;">Mock Data</span>
                        </div>
                    </div>
                    <% } %>
                </div>

                <h3 class="section-title" style="font-size: 1.25rem;">Data Sources</h3>
                <div class="glass-card" style="padding: 0; overflow: hidden;">
                    <div style="overflow-x: auto;">
                        <table class="glass-table">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Status</th>
                                    <th class="text-right">Health Score</th>
                                    <th class="text-right">Success Rate</th>
                                    <th class="text-right">Avg Response</th>
                                    <th>Last Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (health && !health.error && health.sources && health.sources.length > 0) { %>
                                    <% health.sources.forEach(function(source) { %>
                                        <tr>
                                            <td style="font-weight: 600;"><%= source.sourceName || source.sourceId %></td>
                                            <td>
                                                <% if (source.status === 'healthy') { %>
                                                    <span class="badge badge-success">UP</span>
                                                <% } else if (source.status === 'degraded') { %>
                                                    <span class="badge badge-warning">DEGRADED</span>
                                                <% } else { %>
                                                    <span class="badge badge-error">DOWN</span>
                                                <% } %>
                                            </td>
                                            <td class="text-right text-secondary"><%= source.healthScore || '-' %></td>
                                            <td class="text-right text-secondary">
                                                <%= (source.errorMetrics && source.errorMetrics.errorRate !== undefined) ? (100 - source.errorMetrics.errorRate * 100).toFixed(1) + '%' : '-' %>
                                            </td>
                                            <td class="text-right text-secondary">
                                                <%= (source.responseTime && source.responseTime.average) ? Math.round(source.responseTime.average) + ' ms' : '-' %>
                                            </td>
                                            <td class="text-secondary" style="font-size: 0.8rem; max-width: 300px; overflow: hidden; text-overflow: ellipsis;">
                                                <%= source.lastError || '-' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center" style="padding: 2rem;">
                                            <div class="text-secondary">No source data available</div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('partials/footer'); %>
    </div>
</body>

</html>
