<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= coin ? coin.name : 'Not Found' %> - StablecoinWatch</title>
    <link rel="stylesheet" href="/common.css">
    <style>
        .desc-container {
            max-width: 820px;
            color: var(--text-secondary);
            line-height: 1.6;
            font-size: 0.95rem;
        }
        .desc-container p:last-child {
            margin-bottom: 0;
        }
    </style>
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: '' , data: data }); %>

            <main>
                <div class="container">
                    <a href="/" class="back-link">&larr; All Stablecoins</a>

                    <% if (!coin) { %>
                        <div class="glass-card" style="text-align: center; padding: 3rem;">
                            <h2 style="color: var(--text-primary); margin-bottom: 0.5rem;">Stablecoin Not Found</h2>
                            <p class="text-secondary">The requested stablecoin was not found.</p>
                        </div>
                    <% } else {
                        var coins = data.stablecoins || [];
                        var rank = coins.indexOf(coin) + 1;
                        var totalMCap = data.metrics && data.metrics.totalMCap;
                        var cmp = h.getSourceComparison(coin);
                        var pricedRows = cmp.rows.filter(function (r) { return typeof r.price === 'number'; });
                        var heroPrice = cmp.median !== null ? cmp.median : (coin.main && coin.main.price);
                        var peg = h.getPegStatus(coin, heroPrice);
                        var pegWords = { on: 'On peg', drift: 'Drifting', off: 'Off peg' };
                        var chainSupply = h.getChainSupply(coin, 8);
                        var topChain = h.getTopChain(coin);
                        var change = coin.supply_change || {};
                        var mechanism = h.formatMechanism(coin.peg_mechanism);
                        var desc = h.getDescription(coin);
                        var mcapShare = totalMCap > 0 && coin.main && coin.main.circulating_mcap ? (coin.main.circulating_mcap / totalMCap) * 100 : null;
                        var scaleRows = cmp.rows.filter(function (r) { return r.position !== null; });
                        var compact2 = function (v) { return h.formatCompact(v, { decimals: 2 }); };
                    %>
                        <section class="hero" aria-label="<%= coin.name %>">
                            <div class="hero-main">
                                <img src="<%= h.getImage(coin) %>" alt="" class="hero-icon" onerror="this.style.display='none'">
                                <div>
                                    <h1><%= coin.name %></h1>
                                    <div class="hero-tags">
                                        <span class="hero-symbol"><%= coin.symbol %></span>
                                        <% if (mechanism) { %><span class="tag"><%= mechanism %></span><% } %>
                                        <% if (coin.pegged_asset) { %><span class="tag">Pegged to <%= coin.pegged_asset %></span><% } %>
                                        <% if (rank > 0) { %><span class="tag">#<%= rank %> by market cap</span><% } %>
                                    </div>
                                </div>
                            </div>
                            <div class="hero-price">
                                <div class="kpi-label"><%= pricedRows.length > 1 ? 'Price · median of ' + pricedRows.length + ' sources' : 'Price' %></div>
                                <div class="kpi-value"><%= h.formatPegPrice(heroPrice, 5) %></div>
                                <div style="margin-top: 0.5rem;">
                                    <span class="badge <%= peg.badgeClass %>"><%= pegWords[peg.state] ? pegWords[peg.state] + ' · ' + peg.text : peg.text %></span>
                                </div>
                            </div>
                        </section>

                        <section class="card-grid tight section" aria-label="Key figures">
                            <div class="card-pair">
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= coin.mcap_s %></div>
                                    <div class="stat-label">Market Cap</div>
                                    <% if (mcapShare !== null) { %><div class="stat-sub"><%= mcapShare.toFixed(1) %>% of all stablecoins</div><% } %>
                                </div>
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= coin.supply_s %></div>
                                    <div class="stat-label">Circulating Supply</div>
                                    <% if (topChain.count > 0) { %><div class="stat-sub"><%= coin.symbol %> on <%= topChain.count %> chain<%= topChain.count === 1 ? '' : 's' %></div><% } %>
                                </div>
                            </div>
                            <div class="card-pair">
                                <div class="glass-card stat-card">
                                    <div class="stat-value"><%= coin.vol_s && coin.vol_s !== 'No data' ? coin.vol_s : '—' %></div>
                                    <div class="stat-label">Volume (24h)</div>
                                    <% if (cmp.spread.volumeMin !== null) { %>
                                        <div class="stat-sub">Sources range <span class="<%= cmp.spread.volumeRatio > 1.5 ? 'text-warning' : '' %>"><%= h.formatCompact(cmp.spread.volumeMin) %>&ndash;<%= h.formatCompact(cmp.spread.volumeMax) %></span></div>
                                    <% } %>
                                </div>
                                <div class="glass-card stat-card">
                                    <div class="flex" style="justify-content: center; gap: 1rem; font-size: 1.125rem; font-weight: 700;">
                                        <div><div class="<%= h.changeClass(change.d1) %>"><%= h.formatSigned(change.d1) %></div><div class="text-secondary" style="font-size: 0.75rem; font-weight: 500;">1d</div></div>
                                        <div><div class="<%= h.changeClass(change.d7) %>"><%= h.formatSigned(change.d7) %></div><div class="text-secondary" style="font-size: 0.75rem; font-weight: 500;">7d</div></div>
                                        <div><div class="<%= h.changeClass(change.d30) %>"><%= h.formatSigned(change.d30) %></div><div class="text-secondary" style="font-size: 0.75rem; font-weight: 500;">30d</div></div>
                                    </div>
                                    <div class="stat-label">Supply Change</div>
                                </div>
                            </div>
                        </section>

                        <% if (chainSupply.chains.length > 0) { %>
                            <section class="section" aria-labelledby="chains-title">
                                <h2 id="chains-title" class="section-title">Supply by Chain</h2>
                                <div class="breakdown-grid">
                                    <% chainSupply.chains.forEach(function(c) { %>
                                        <div class="breakdown-card">
                                            <div class="breakdown-head">
                                                <a href="/platforms/<%= c.uri %>">
                                                    <img src="<%= h.getChainIcon(c.name) %>" alt="" class="logo logo-sm" style="width: 18px; height: 18px;" loading="lazy" onerror="this.style.display='none'"><%= c.name %>
                                                </a>
                                                <span class="breakdown-pct"><%= h.formatShare(c.pct) %></span>
                                            </div>
                                            <div class="breakdown-row">
                                                <span style="font-weight: 600;"><%= h.formatCompact(c.supply, { dollar: false, decimals: 2 }) %> <%= coin.symbol %></span>
                                                <% if (c.change7d !== null) { %><span class="<%= h.changeClass(c.change7d) %>" style="font-size: 0.8125rem; font-weight: 500;"><%= h.formatSigned(c.change7d) %> 7d</span><% } %>
                                            </div>
                                            <div class="supply-bar">
                                                <div class="supply-bar-fill" style="width: <%= Math.min(c.pct, 100).toFixed(2) %>%"></div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                <% if (chainSupply.rest.count > 0) { %>
                                    <p class="breakdown-more">
                                        &hellip; and <%= chainSupply.rest.count %> more chain<%= chainSupply.rest.count === 1 ? '' : 's' %> holding
                                        <%= h.formatCompact(chainSupply.rest.supply, { dollar: false, decimals: 2 }) %> <%= coin.symbol %> (<%= h.formatShare(chainSupply.rest.pct) %>)
                                    </p>
                                <% } %>
                            </section>
                        <% } %>

                        <% if (coin.pegged_asset === 'USD' && peg.text !== 'Yield-bearing' && scaleRows.length > 0) { %>
                            <section class="section" aria-labelledby="peg-title">
                                <h2 id="peg-title" class="section-title">Price by Source</h2>
                                <div class="glass-card">
                                    <p class="text-secondary" style="margin-top: 0; font-size: 0.875rem;">Distance from the $1.00 peg in basis points (1 bp = 0.01%)</p>
                                    <div class="peg-scale">
                                        <% scaleRows.forEach(function(r) { %>
                                            <div class="peg-row">
                                                <span style="font-weight: 600;"><%= r.name %></span>
                                                <div class="peg-track" aria-hidden="true"><span class="peg-marker" style="left: <%= r.position.toFixed(1) %>%;"></span></div>
                                                <span class="peg-value"><%= h.formatPegPrice(r.price, 5) %> <span class="text-secondary"><%= h.formatSigned(r.bp, 1, ' bp') %></span></span>
                                            </div>
                                        <% }); %>
                                        <div class="peg-row" aria-hidden="true">
                                            <span></span>
                                            <div class="peg-axis"><span>&minus;<%= cmp.scaleBp %> bp</span><span>$1.00</span><span>+<%= cmp.scaleBp %> bp</span></div>
                                            <span></span>
                                        </div>
                                    </div>
                                    <% if (cmp.spread.priceBp !== null) { %>
                                        <p class="card-note text-secondary">
                                            Sources agree within <strong class="text-primary"><%= cmp.spread.priceBp.toFixed(1) %> bp</strong>.
                                            <%= scaleRows.every(function (r) { return Math.abs(r.bp) <= 10; })
                                                ? 'All ' + scaleRows.length + ' are inside the 10 bp on-peg band.'
                                                : 'At least one source prices it more than 10 bp from the peg.' %>
                                        </p>
                                    <% } %>
                                </div>
                            </section>
                        <% } %>

                        <% if (cmp.rows.length > 0) { %>
                            <section class="section" aria-labelledby="sources-title">
                                <h2 id="sources-title" class="section-title">Source Comparison</h2>
                                <div class="glass-card table-card">
                                    <div class="table-scroll">
                                        <table class="glass-table" style="min-width: 760px;">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Source</th>
                                                    <th scope="col" class="text-right">Price</th>
                                                    <th scope="col" class="text-right">From Peg</th>
                                                    <th scope="col" class="text-right">Market Cap</th>
                                                    <th scope="col" class="text-right">Volume (24h)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% cmp.rows.forEach(function(r) { %>
                                                    <tr>
                                                        <th scope="row">
                                                            <div style="font-weight: 600;"><%= r.name %></div>
                                                            <div class="coin-sub" style="font-weight: 400;"><%= r.role %></div>
                                                        </th>
                                                        <td class="num <%= r.shown.price ? 'shown-value' : '' %>"><%= h.formatPegPrice(r.price, 5) %></td>
                                                        <td class="num text-secondary"><%= r.bp !== null ? h.formatSigned(r.bp, 1, ' bp') : '—' %></td>
                                                        <td class="num <%= r.shown.marketCap ? 'shown-value' : '' %>"><%= compact2(r.marketCap) %></td>
                                                        <td class="num <%= r.shown.volume ? 'shown-value' : '' %>"><%= typeof r.volume === 'number' ? compact2(r.volume) : 'Not reported' %></td>
                                                    </tr>
                                                <% }); %>
                                                <% if (cmp.rows.length > 1) { %>
                                                    <tr style="background: rgba(255, 255, 255, 0.02);">
                                                        <th scope="row" class="text-secondary" style="font-weight: 600;">Spread</th>
                                                        <td class="num text-secondary"><%= cmp.spread.priceBp !== null ? cmp.spread.priceBp.toFixed(1) + ' bp' : '—' %></td>
                                                        <td></td>
                                                        <td class="num text-secondary"><%= cmp.spread.marketCapPct !== null ? cmp.spread.marketCapPct.toFixed(2) + '%' : '—' %></td>
                                                        <td class="num">
                                                            <% if (cmp.spread.volumeRatio !== null) { %>
                                                                <span class="badge <%= cmp.spread.volumeRatio > 1.5 ? 'badge-warning' : 'badge-neutral' %>"><%= cmp.spread.volumeRatio.toFixed(1) %>&times;</span>
                                                            <% } else { %>&mdash;<% } %>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <p class="text-secondary" style="margin-top: 0.75rem; font-size: 0.875rem;">
                                    Blue values are the ones StablecoinWatch shows. Each source counts volume differently, so a wide spread is expected.
                                </p>
                            </section>
                        <% } %>

                        <% if (desc) { %>
                            <section aria-labelledby="about-title">
                                <h2 id="about-title" class="section-title">About <%= coin.name %></h2>
                                <div class="glass-card">
                                    <div class="desc-container">
                                        <p><%- desc.html %></p>
                                    </div>
                                    <p class="text-secondary" style="margin: 1rem 0 0; font-size: 0.8125rem;">Description from <%= desc.source %>.</p>
                                </div>
                            </section>
                        <% } %>
                    <% } %>
                </div>
            </main>

            <%- include('partials/footer'); %>
    </div>
</body>

</html>
