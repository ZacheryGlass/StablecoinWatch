<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coins - StablecoinWatch</title>
    <link rel="stylesheet" href="/common.css">
</head>

<body>
    <div id="wrapper">
        <%- include('partials/header', { active: 'coins' , data: data }); %>

            <main>
                <div class="container">
                    <h2 class="section-title">All Stablecoins</h2>

                    <div class="glass-card" style="padding: 0; overflow: hidden;">
                        <div style="overflow-x: auto;">
                            <table class="glass-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Name</th>
                                        <th>Price</th>
                                        <th class="text-right">Market Cap</th>
                                        <th class="text-right">Volume (24h)</th>
                                        <th class="text-right">Circulating Supply</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (data && data.stablecoins && data.stablecoins.length> 0) { %>
                                        <% data.stablecoins.forEach(function(coin, index) { %>
                                            <tr onclick="window.location='/coin/<%= coin.symbol %>'"
                                                style="cursor: pointer;">
                                                <td>
                                                    <span class="text-secondary">#<%= index + 1 %></span>
                                                </td>
                                                <td>
                                                    <div class="flex items-center gap-md">
                                                        <% if (coin.img_url) { %>
                                                            <img src="<%= coin.img_url %>" alt="<%= coin.name %>"
                                                                style="width: 32px; height: 32px; border-radius: 50%;">
                                                            <% } %>
                                                                <div>
                                                                    <div style="font-weight: 600;">
                                                                        <%= coin.name %>
                                                                    </div>
                                                                    <div class="text-secondary"
                                                                        style="font-size: 0.75rem;">
                                                                        <%= coin.symbol %>
                                                                    </div>
                                                                </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="font-weight: 500;"><%= coin.price_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div style="font-weight: 500;">
                                                        <%= coin.mcap_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div style="font-weight: 500;">
                                                        <%= coin.vol_s %>
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <div class="text-secondary">
                                                        <%= coin.supply_s %>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="text-center" style="padding: 3rem;">
                                                            <div class="text-secondary">No coin data available</div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>

            <%- include('partials/footer'); %>
    </div>
</body>

</html>